{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt|og-image\\.png|favicon\\.svg|google.*\\.html).*)", "destination": "/index.html" }
  ]
}
